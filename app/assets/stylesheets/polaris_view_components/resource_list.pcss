/* Resource-list composition: compact rows within the enclosing section surface. */
html[class~="Polaris-Summer-Editions-2023"] {
  .Polaris-LegacyCard__Surface > .Polaris-ResourceList__ResourceListWrapper {
    border-radius: inherit;
  }

  .Polaris-ResourceList__ResourceListWrapper {
    & > .Polaris-ResourceList:first-child { border-top-left-radius: inherit; border-top-right-radius: inherit; }
    & > .Polaris-ResourceList:last-child { border-bottom-left-radius: inherit; border-bottom-right-radius: inherit; }
  }

  .Polaris-ResourceList {
    & > .Polaris-ResourceItem__ListItem:first-child { border-top-left-radius: inherit; border-top-right-radius: inherit; }
    & > .Polaris-ResourceItem__ListItem:last-child { border-bottom-left-radius: inherit; border-bottom-right-radius: inherit; }
  }

  .Polaris-ResourceItem__ItemWrapper,
  .Polaris-ResourceItem { border-radius: inherit; }

  .Polaris-ResourceItem {
    &:hover { background: var(--p-color-bg-surface-hover); }
    &:active { background: var(--p-color-bg-surface-active); }

    &--selected { background: var(--p-color-bg-surface-selected); }
    &--selected:hover,
    &--selected:active { background: var(--p-color-bg-surface-secondary-selected); }

    h3,
    h3 .Polaris-Text--semibold {
      font-size: 0.8125rem;
      line-height: 1.25rem;
      font-weight: var(--p-font-weight-medium);
    }
  }

  .Polaris-ResourceItem__Container {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .Polaris-ResourceItem__ListItem:has(.Polaris-ResourceItem__Link:focus-visible)::after {
    z-index: 3;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--p-color-border-focus);
  }

  .Polaris-ResourceList__FiltersWrapper { padding: var(--p-space-400); }

  .Polaris-ResourceList__HeaderOuterWrapper { border-radius: inherit; }

  .Polaris-ResourceList__HeaderWrapper {
    min-height: 3rem;
    padding: var(--p-space-200) var(--p-space-400);
    border-radius: inherit;
  }

  .Polaris-ResourceList__HeaderContentWrapper {
    position: static;
    min-width: 0;
    min-height: 2rem;
  }

  .Polaris-ResourceList__HeaderTitleWrapper { white-space: normal; }

  .Polaris-ResourceItem__Actions {
    display: flex;
    align-items: center;
    opacity: 0;
    pointer-events: none;

    & > * { clip: auto; overflow: visible; }
  }

  .Polaris-ResourceItem:hover .Polaris-ResourceItem__Actions,
  .Polaris-ResourceItem:focus-within .Polaris-ResourceItem__Actions,
  .Polaris-ResourceItem--persistActions .Polaris-ResourceItem__Actions {
    opacity: 1;
    pointer-events: auto;
  }

  .Polaris-ResourceItem__Disclosure {
    display: none;

    .Polaris-Button--iconOnly {
      width: 1.75rem;
      height: 1.75rem;
      padding: var(--p-space-100);
    }
  }

  @media (max-width: 46.5em), (hover: none) {
    .Polaris-ResourceItem__Actions { display: none; }
    .Polaris-ResourceItem__Disclosure { display: flex; align-items: center; }
  }

  @media (min-width: 48.0625em) and (max-width: 61.5em) {
    [data-has-navigation] .Polaris-ResourceItem__Actions { display: none; }
    [data-has-navigation] .Polaris-ResourceItem__Disclosure { display: flex; align-items: center; }
  }
}
