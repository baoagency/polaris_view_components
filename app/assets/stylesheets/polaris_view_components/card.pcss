html[class~="Polaris-Summer-Editions-2023"] .Polaris-LegacyCard {
  .Polaris-LegacyCard__Header {
    padding-top: var(--p-space-400);
  }

  .Polaris-LegacyCard__Header+.Polaris-LegacyCard__Section {
    padding-top: var(--p-space-200);
  }

  .Polaris-LegacyCard__Section {
    padding: var(--p-space-400) var(--p-space-400) var(--p-space-200);

    &+.Polaris-LegacyCard__Section {
      padding-top: var(--p-space-200);
    }

    &:last-child {
      padding-bottom: var(--p-space-400);
    }

    &.Polaris-LegacyCard__Section--flush {
      padding: 0;

      img {
        border-top-left-radius: var(--p-border-radius-container);
        border-top-right-radius: var(--p-border-radius-container);
        width: 100%;
      }
    }
  }

  .Polaris-LegacyCard__Section--subdued {
    padding-top: var(--p-space-300);
    padding-bottom: var(--p-space-300);

    &:last-child {
      padding-bottom: var(--p-space-400);
    }
  }

  .Polaris-LegacyCard__Footer {
    padding-top: var(--p-space-100);
  }

  &.Polaris-LegacyCard--withoutTitle {
    .Polaris-LegacyCard__Section:first-child {
      padding-top: var(--p-space-400);
    }
  }

  &.Polaris-LegacyCard--borderless {
    border: none;
    box-shadow: none;

    &::before {
      content: none;
    }
  }
}

@media (min-width: 30.625em) {
  html[class~="Polaris-Summer-Editions-2023"] .Polaris-LegacyCard {
    border: none;
    border-radius: var(--p-border-radius-container);
    box-shadow: var(--p-shadow-container);

    &::before {
      content: none;
    }

    .Polaris-LegacyCard__Section:first-child {
      border-top-left-radius: var(--p-border-radius-container);
      border-top-right-radius: var(--p-border-radius-container);
    }

    .Polaris-LegacyCard__Section:last-child {
      border-bottom-left-radius: var(--p-border-radius-container);
      border-bottom-right-radius: var(--p-border-radius-container);
    }

    &.Polaris-LegacyCard--borderless {
      box-shadow: none;
    }
  }
}
