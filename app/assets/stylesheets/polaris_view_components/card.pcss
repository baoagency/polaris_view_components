html[class~="Polaris-Summer-Editions-2023"] .Polaris-LegacyCard {
  --pc-card-surface-bg: var(--p-color-bg-surface);

  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;

  &::before { content: none; }

  & + .Polaris-LegacyCard { margin-top: var(--p-space-600); }

  .Polaris-LegacyCard__Header,
  .Polaris-LegacyCard__SectionHeader {
    .Polaris-ButtonGroup {
      margin: 0;
      gap: var(--p-space-200);

      & > .Polaris-ButtonGroup__Item { margin: 0; }
    }
  }

  & > .Polaris-LegacyCard__Header {
    display: flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0;
    margin-bottom: var(--p-space-300);
    overflow-wrap: anywhere;

    .Polaris-Text--headingMd {
      font-size: 0.9375rem;
      line-height: 1.375rem;
      letter-spacing: -0.01em;
    }

    & > .Polaris-LegacyStack {
      flex: 1;
      min-width: 0;
      margin: 0;
      gap: var(--p-space-200);
      align-items: center;

      & > .Polaris-LegacyStack__Item { margin: 0; min-width: 0; }
      & > .Polaris-LegacyStack__Item--fill { flex: 1 1 10rem; }
    }

    .Polaris-Button--plain { margin: 0; }
  }

  & > .Polaris-LegacyCard__Surface {
    min-width: 0;
    background: var(--pc-card-surface-bg);
    border-radius: var(--p-border-radius-container);
    box-shadow: var(--p-shadow-container);

    & > .Polaris-LegacyCard__Section {
      padding: var(--p-space-400) var(--p-space-400) var(--p-space-200);

      & + .Polaris-LegacyCard__Section { padding-top: var(--p-space-200); }
      &:last-child { padding-bottom: var(--p-space-400); }

      &:first-child {
        border-top-left-radius: var(--p-border-radius-container);
        border-top-right-radius: var(--p-border-radius-container);
      }

      &:last-child {
        border-bottom-left-radius: var(--p-border-radius-container);
        border-bottom-right-radius: var(--p-border-radius-container);
      }

      &.Polaris-LegacyCard__Section--subdued {
        padding-top: var(--p-space-300);
        padding-bottom: var(--p-space-300);

        &:last-child { padding-bottom: var(--p-space-400); }
      }

      &.Polaris-LegacyCard__Section--fullWidth { padding-inline: 0; }

      &:has(> .Polaris-LegacyFilters) { padding-bottom: var(--p-space-400); }

      &.Polaris-LegacyCard__Section--flush {
        padding: 0;

        img { display: block; width: 100%; }
        &:first-child img {
          border-top-left-radius: var(--p-border-radius-container);
          border-top-right-radius: var(--p-border-radius-container);
        }
        &:last-child img {
          border-bottom-left-radius: var(--p-border-radius-container);
          border-bottom-right-radius: var(--p-border-radius-container);
        }
      }
    }

    & > .Polaris-LegacyCard__Footer {
      padding-top: var(--p-space-100);
      &:first-child { padding-top: var(--p-space-400); }
    }
  }

  &.Polaris-LegacyCard--subdued { --pc-card-surface-bg: var(--p-color-bg-surface-secondary); }

  &.Polaris-LegacyCard--borderless > .Polaris-LegacyCard__Surface { box-shadow: none; }
}
