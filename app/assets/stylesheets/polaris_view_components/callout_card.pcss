html[class~="Polaris-Summer-Editions-2023"] .Polaris-CalloutCard__Container {
  container-type: inline-size;
  padding: 0;

  & > .Polaris-LegacyCard__Section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--p-space-100);
  }

  &.Polaris-CalloutCard--hasDismiss > .Polaris-LegacyCard__Section {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .Polaris-CalloutCard {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--p-space-400);
    min-width: 0;

    &:has(.Polaris-CalloutCard__Illustration) { grid-template-columns: auto auto; }
  }

  .Polaris-CalloutCard__Content {
    display: grid;
    gap: var(--p-space-200);
    min-width: 0;
  }

  .Polaris-CalloutCard__Title,
  .Polaris-CalloutCard__Buttons { margin: 0; }

  .Polaris-CalloutCard__Buttons .Polaris-ButtonGroup {
    margin: 0;
    gap: var(--p-space-200);

    & > .Polaris-ButtonGroup__Item { margin: 0; }
  }

  .Polaris-CalloutCard__Illustration {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .Polaris-CalloutCard__Image {
    display: block;
    width: 12.5rem;
    max-width: 100%;
    height: 6.25rem;
    object-fit: contain;
    margin: 0;
    border-radius: var(--p-border-radius-200);
  }

  .Polaris-CalloutCard__Dismiss {
    position: static;
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
  }
}

@container (max-width: 480px) {
  html[class~="Polaris-Summer-Editions-2023"] .Polaris-CalloutCard__Container .Polaris-CalloutCard:has(.Polaris-CalloutCard__Illustration) {
    grid-template-columns: minmax(0, 1fr);
  }
}
