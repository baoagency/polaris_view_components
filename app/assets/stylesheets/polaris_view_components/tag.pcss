html[class~="Polaris-Summer-Editions-2023"] .Polaris-Tag {
  min-height: 1.25rem;
  padding: var(--p-space-025) var(--p-space-200);
  border-radius: var(--p-border-radius-tag);
  background-color: var(--p-color-bg-fill-transparent);
  color: var(--p-color-text-secondary);
  font-size: var(--p-font-size-300);
  font-weight: var(--p-font-weight-medium);
  line-height: 1.125rem;
  letter-spacing: -0.005em;

  &.Polaris-Tag--removable {
    padding-right: var(--p-space-050);
  }

  &.Polaris-Tag--clickable,
  &.Polaris-Tag--linkable {
    &:hover {
      background: var(--p-color-bg-fill-transparent-hover);
    }

    &:active {
      background: var(--p-color-bg-fill-transparent-active);
    }
  }

  &.Polaris-Tag--disabled {
    background: var(--p-color-bg-fill-disabled);
    color: var(--p-color-text-disabled);
  }

  .Polaris-Tag__Button {
    border-radius: var(--p-border-radius-full);

    svg {
      fill: var(--p-color-icon-secondary);
    }

    &:hover {
      background: var(--p-color-bg-fill-transparent-hover);
    }
  }
}
