<%= render Polaris::BaseComponent.new(**system_arguments) do %>
  <div class="Polaris-Banner__Body">
    <div class="Polaris-Banner__ContentWrapper">
      <% unless @hide_icon && !has_title? %>
        <div class="Polaris-Banner__Heading">
          <% unless @hide_icon %>
            <span class="Polaris-Banner__InlineIcon"><%= render_icon %></span>
          <% end %>
          <% if has_title? %>
            <%= polaris_text(as: :h2, variant: :headingSm, break_word: true) { @title } %>
          <% end %>
        </div>
      <% end %>
      <% if content.present? %>
        <div class="Polaris-Banner__Message"><%= content %></div>
      <% end %>
    </div>
    <% if action || secondary_action %>
      <div class="Polaris-Banner__Actions">
        <%= polaris_button_group do |group| %>
          <% if action %>
            <% group.with_item do %>
              <%= action %>
            <% end %>
          <% end %>
          <% if secondary_action %>
            <% group.with_item do %>
              <%= secondary_action %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if dismiss_button %>
      <div class="Polaris-Banner__DismissButton"><%= dismiss_button %></div>
    <% end %>
  </div>
<% end %>
