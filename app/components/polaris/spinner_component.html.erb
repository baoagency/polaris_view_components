<%= render Polaris::BaseComponent.new(**@system_arguments) do %>
  <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true" focusable="false">
    <circle class="Polaris-Spinner__Track" r="<%= @size == :small ? 14 : 19 %>" stroke-width="<%= @size == :small ? 3 : 2 %>" cx="22" cy="22" />
    <circle class="Polaris-Spinner__Indicator" pathLength="10" r="<%= @size == :small ? 14 : 19 %>" stroke-width="<%= @size == :small ? 3 : 2 %>" cx="22" cy="22" />
  </svg>
<% end %>

<% if render_accessibility? %>
  <%= render Polaris::BaseComponent.new(**span_arguments) do %>
    <%= render Polaris::TextComponent.new(as: :span, variant: :bodySm, visually_hidden: true).with_content(@accessibility_label) %>
  <% end %>
<% end %>
